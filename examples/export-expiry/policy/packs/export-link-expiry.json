{
  "id": "export-link-expiry",
  "title": "Download link expiry",
  "version": "1.0.0",
  "description": "Time limit for links used to download an export.",
  "sources": [],
  "rules": [
    {
      "id": "export-link-expiry",
      "check": {
        "kind": "field",
        "path": "export.json",
        "field": "downloadLinkMinutes",
        "integer": true,
        "min": 1,
        "max": 60
      }
    }
  ]
}
