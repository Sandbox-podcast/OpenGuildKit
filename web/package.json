{
  "name": "openguildkit-web",
  "private": true,
  "version": "0.1.0",
  "description": "Open Guild Kit — interface web d'un projet (openguildkit ui) et démonstration Atelier Nova (npm run dev).",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "tsc -b && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --outDir dist-demo",
    "typecheck": "tsc -b",
    "catalogue": "vite-node scripts/build-catalogue.ts",
    "docs:roles": "vite-node scripts/roles-matrix.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "bundle": "node scripts/bundle.mjs",
    "check:exports": "node scripts/unused-exports.mjs",
    "check:ratchet": "node scripts/check-ratchet.mjs longLines indexedAccess",
    "lint": "node scripts/check-ratchet.mjs lint",
    "format": "prettier --write",
    "format:check": "node scripts/check-ratchet.mjs unformatted",
    "e2e:project": "playwright test -c playwright.project.config.ts",
    "sample": "python scripts/sample-project.py",
    "measure:project": "node scripts/measure-project.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "diff": "^9.0.0",
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.2"
  }
}
