{
  "name": "openguildkit-web",
  "private": true,
  "version": "0.1.0",
  "description": "Open Guild Kit — interface web : démonstration interactive et interface de vos projets (openguildkit ui).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "catalogue": "vite-node scripts/build-catalogue.ts",
    "docs:roles": "vite-node scripts/roles-matrix.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "bundle": "node scripts/bundle.mjs",
    "e2e:project": "playwright test -c playwright.project.config.ts",
    "sample": "python scripts/sample-project.py",
    "measure:project": "node scripts/measure-project.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "diff": "^9.0.0",
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  }
}
