      "servers": [
        {
          "id": "gmail-mcp",
          "name": "Gmail MCP server",
          "publisher": "vendor",
          "maintainer": "Google",
          "transport": "streamable-http",
          "url": "https://gmailmcp.googleapis.com/mcp/v1",
          "auth": "oauth",
          "env": [],
          "status": "preview",
          "capabilities": "Read and act on Gmail messages.",
          "source": "https://developers.google.com/workspace/guides/configure-mcp-servers",
          "verified": "2026-11-21",
          "access": {
            "mode": "read-write",
            "consent": "Configure a Google Cloud OAuth client, enable the API and obtain user consent",
            "scopes": [
              "https://www.googleapis.com/auth/gmail.readonly",
              "https://www.googleapis.com/auth/gmail.compose",
              "https://www.googleapis.com/auth/gmail.modify"
            ]
          }
        },
        {
          "id": "calendar-mcp",
          "name": "Google Calendar MCP server",
          "publisher": "vendor",
          "maintainer": "Google",
          "transport": "streamable-http",
          "url": "https://calendarmcp.googleapis.com/mcp/v1",
          "auth": "oauth",
          "env": [],
          "status": "preview",
          "capabilities": "Read and manage Google Calendar events.",
          "source": "https://developers.google.com/workspace/guides/configure-mcp-servers",
          "verified": "2026-11-21",
          "access": {
            "mode": "read-write",
            "consent": "Configure a Google Cloud OAuth client, enable the API and obtain user consent",
            "scopes": [
              "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
              "https://www.googleapis.com/auth/calendar.events.freebusy",
              "https://www.googleapis.com/auth/calendar.events.readonly",
              "https://www.googleapis.com/auth/calendar.events"
            ]
          }
        },
        {
          "id": "drive-mcp",
          "name": "Google Drive MCP server",
          "publisher": "vendor",
          "maintainer": "Google",
          "transport": "streamable-http",
          "url": "https://drivemcp.googleapis.com/mcp/v1",
          "auth": "oauth",
          "env": [],
          "status": "preview",
          "capabilities": "Search and read Drive files; the drive.file scope can grant write access to specific files.",
          "source": "https://developers.google.com/workspace/guides/configure-mcp-servers",
          "verified": "2026-11-21",
          "access": {
            "mode": "read-write",
            "consent": "Configure a Google Cloud OAuth client, enable the API and obtain user consent",
            "scopes": [
              "https://www.googleapis.com/auth/drive.readonly",
              "https://www.googleapis.com/auth/drive.file"
            ]
          }
        },
        {
          "id": "workspace-universal-search-mcp",
          "name": "Universal Search MCP server for Workspace",
          "publisher": "vendor",
          "maintainer": "Google",
          "transport": "streamable-http",
          "url": "https://workspacemcp.googleapis.com/mcp/v1",
          "auth": "oauth",
          "env": [],
          "status": "preview",
          "capabilities": "One search_corpus tool searching across Drive, Gmail, Calendar and Chat.",
          "source": "https://developers.google.com/workspace/guides/configure-mcp-servers",
          "verified": "2026-11-21",
          "access": {
            "mode": "read-only",
            "consent": "Configure a Google Cloud OAuth client, enable the API and obtain user consent",
            "scopes": [
              "https://www.googleapis.com/auth/gmail.readonly",
              "https://www.googleapis.com/auth/drive.readonly",
              "https://www.googleapis.com/auth/calendar.readonly",
              "https://www.googleapis.com/auth/chat.messages.readonly",
              "https://www.googleapis.com/auth/chat.spaces.readonly",
              "https://www.googleapis.com/auth/chat.memberships.readonly"
            ]
          }
        }
      ],
      "api": {
        "kind": "rest",
        "docs": "https://developers.google.com/workspace"
      },
      "notes": "Developer Preview: requires membership in the Google Workspace Developer Preview Program, a Google Cloud project with the product API and its MCP service enabled, and an OAuth client. Docs, Sheets, Slides, Chat, People and Classroom have their own endpoints on the same page."
