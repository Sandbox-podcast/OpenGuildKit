      "servers": [
        {
          "id": "work-iq-mcp",
          "name": "Work IQ MCP",
          "publisher": "vendor",
          "maintainer": "Microsoft",
          "transport": "streamable-http",
          "url": "https://workiq.svc.cloud.microsoft/mcp",
          "auth": "oauth",
          "env": [],
          "status": "ga",
          "capabilities": "Single endpoint with generic tools to read, create, update and delete Microsoft 365 entities (mail, meetings, files, Teams chats, people); the retrieve tool is still in preview.",
          "source": "https://learn.microsoft.com/en-us/azure/foundry/agents/how-to/tools/work-iq",
          "verified": "2026-11-21",
          "access": {
            "mode": "read-write",
            "consent": "Tenant-wide Entra administrator consent and delegated sign-in with the user's Microsoft 365 permissions",
            "scopes": [
              "api://workiq.svc.cloud.microsoft/WorkIQAgent.Ask"
            ]
          }
        },
        {
          "id": "work-iq-cli",
          "name": "Work IQ CLI (MCP server mode)",
          "publisher": "vendor",
          "maintainer": "Microsoft",
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@microsoft/workiq",
            "mcp"
          ],
          "package": {
            "registry": "npm",
            "name": "@microsoft/workiq"
          },
          "auth": "oauth",
          "env": [],
          "status": "ga",
          "capabilities": "Query emails, meetings, documents, Teams messages, people and business-app data from Microsoft 365 Copilot in natural language.",
          "source": "https://learn.microsoft.com/en-us/microsoft-365/copilot/extensibility/work-iq/cli",
          "repository": "https://github.com/microsoft/work-iq-mcp",
          "verified": "2026-11-21",
          "access": {
            "mode": "read"
          }
        }
      ],
      "api": {
        "kind": "rest",
        "docs": "https://learn.microsoft.com/en-us/graph/overview"
      },
      "notes": "Work IQ needs delegated Microsoft Entra auth with tenant-wide admin consent and a Copilot Studio usage-based billing plan (Copilot Credits); app-only auth is not supported. Microsoft's older workload servers (Teams, Mail, Calendar, SharePoint, OneDrive, preview) are kept only for backward compatibility and must not be used for new projects."
