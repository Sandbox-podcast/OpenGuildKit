{
  "tool": "factorial",
  "instructions": "Mock of an HR tool for the fictional Acme Support Portal team. Every answer is synthetic.",
  "tools": [
    {
      "name": "list_employees",
      "description": "List employees with team and role.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "team": {
            "type": "string",
            "description": "Optional team name, for example Engineering"
          }
        }
      },
      "serve": {
        "records": "employees",
        "action": "list"
      }
    },
    {
      "name": "list_time_off",
      "description": "List approved time off. Filter by employee name or by sprint number.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "employee": {
            "type": "string",
            "description": "Part of an employee name"
          },
          "sprint": {
            "type": "string",
            "description": "Sprint number, for example 14"
          }
        }
      },
      "serve": {
        "records": "time_off",
        "action": "list"
      }
    },
    {
      "name": "get_employee",
      "description": "Get one employee by id.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "employee_id": {
            "type": "string",
            "description": "Employee id such as emp-ada"
          }
        },
        "required": [
          "employee_id"
        ]
      },
      "serve": {
        "records": "employees",
        "action": "get"
      }
    }
  ],
  "records": {
    "employees": {
