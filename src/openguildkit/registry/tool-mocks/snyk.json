{
  "tool": "snyk",
  "instructions": "Mock of a dependency security scanner for the fictional Acme Support Portal. Every answer is synthetic.",
  "tools": [
    {
      "name": "list_projects",
      "description": "List scanned projects with their issue counts.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words that must all appear, whatever the case; an empty text lists everything"
          }
        }
      },
      "serve": {
        "records": "projects",
        "action": "list"
      }
    },
    {
      "name": "list_issues",
      "description": "List the issues of a project. Returns id, title, severity, type and package.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "description": "Project name"
          },
          "severity": {
            "type": "string",
            "description": "Optional severity",
            "enum": [
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "project"
        ]
      },
      "serve": {
        "records": "issues",
        "action": "list",
        "fields": [
          "issue_id",
          "title",
          "severity",
          "type",
          "package",
          "project"
        ]
      }
    },
    {
      "name": "get_issue",
      "description": "Get one issue by id, with the fixed version when there is one.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "Issue id from list_issues"
          }
        },
        "required": [
          "issue_id"
        ]
      },
      "serve": {
        "records": "issues",
        "action": "get"
      }
    }
  ],
  "records": {
    "projects": {
      "key": "name",
      "title": "name",
      "items": [
        {
          "name": "support-portal",
          "issues": {
            "high": 1,
            "medium": 1
          },
          "last_scan": "2026-11-21"
        },
        {
          "name": "support-portal-docs",
          "issues": {
            "high": 0,
            "medium": 0
          },
          "last_scan": "2026-11-20"
        }
      ]
    },
    "issues": {
      "key": "issue_id",
      "title": "title",
      "items": [
        {
          "issue_id": "SNYK-JS-CSVHELPER-1",
          "title": "Formula injection in csv-helper",
          "severity": "high",
          "type": "vulnerability",
          "package": "csv-helper",
          "installed": "1.2.0",
          "fixed_in": "1.2.4",
          "project": "support-portal",
          "description": "Cells that start with = are written without protection, so a spreadsheet can run them as formulas.",
          "introduced_by": "feat/request-export"
        },
        {
          "issue_id": "SNYK-LIC-1",
          "title": "Licence needs a review: Example-Copyleft-1.0",
          "severity": "medium",
          "type": "licence",
          "package": "table-layout-sample",
          "installed": "3.1.0",
          "fixed_in": null,
          "project": "support-portal",
          "description": "The licence of this package asks for a legal review before the portal ships it."
        }
      ],
      "refs": {
        "project": "projects"
      }
    }
  }
}
