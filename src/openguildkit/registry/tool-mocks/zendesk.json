    {
      "name": "add_internal_note",
      "description": "Add an internal note to a ticket. Returns the note.",
      "inputSchema": {
        "type": "object",
        "properties": {"ticket_id": {"type": "integer", "description": "Ticket id"}, "body": {"type": "string", "description": "Note text"}},
        "required": ["ticket_id", "body"]
      },
      "responses": [
        {
          "result": {
            "ticket_id": "$arg:ticket_id",
            "note_id": "note-77",
            "visibility": "internal",
            "body": "$arg:body",
            "author": "Kai Demo",
