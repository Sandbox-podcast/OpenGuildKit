{
  "tool": "figma",
  "instructions": "Mock of a design tool with one fictional file, Requests list. Every answer is synthetic.",
  "tools": [
    {
      "name": "get_file",
      "description": "Get a file and the frames of its screens.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_key": {
            "type": "string",
            "description": "File key such as requests-list"
          }
        },
        "required": [
          "file_key"
        ]
      },
      "serve": {
        "records": "files",
        "action": "get"
      }
    },
    {
      "name": "get_node",
      "description": "Get one node of a file, with its sizes, states and colour tokens.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "description": "Node id such as 12:34"
          }
        },
        "required": [
          "node_id"
        ]
      },
      "serve": {
        "records": "nodes",
        "action": "get"
      }
    },
    {
      "name": "list_comments",
      "description": "List the comments of a file.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_key": {
            "type": "string",
            "description": "File key"
          }
        }
      },
      "serve": {
        "records": "comments",
        "action": "list"
      }
    }
  ],
  "records": {
    "files": {
      "key": "file_key",
      "title": "name",
