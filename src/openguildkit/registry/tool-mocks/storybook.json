{
  "tool": "storybook",
  "instructions": "Mock of a component catalogue for the fictional Acme Support Portal front end. Every answer is synthetic.",
  "tools": [
    {
      "name": "list_stories",
      "description": "List stories. Returns id, component title and story name.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "description": "Optional component name"
          }
        }
      },
      "serve": {
        "records": "stories",
        "action": "list",
        "fields": [
          "story_id",
          "title",
          "name",
          "component"
        ]
      }
    },
    {
      "name": "get_story",
      "description": "Get one story with its args and source file.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "story_id": {
            "type": "string",
            "description": "Story id such as requests-exportbutton--default"
          }
        },
        "required": [
          "story_id"
        ]
      },
      "serve": {
        "records": "stories",
        "action": "get"
      }
    },
    {
      "name": "list_components",
      "description": "List components with their story counts.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words that must all appear, whatever the case; an empty text lists everything"
          }
        }
      },
      "serve": {
        "records": "components",
        "action": "list"
      }
    }
  ],
  "records": {
    "stories": {
      "key": "story_id",
      "title": "title",
      "items": [
        {
          "story_id": "requests-exportbutton--default",
          "title": "Requests/ExportButton",
          "name": "Default",
          "component": "ExportButton",
          "args": {
            "label": "Export CSV",
            "disabled": false
          },
          "source_file": "src/components/ExportButton.stories.tsx"
        },
        {
          "story_id": "requests-exportbutton--disabled",
          "title": "Requests/ExportButton",
          "name": "Disabled",
          "component": "ExportButton",
          "args": {
            "label": "Export CSV",
            "disabled": true
          },
          "source_file": "src/components/ExportButton.stories.tsx"
        },
        {
          "story_id": "requests-requeststable--default",
          "title": "Requests/RequestsTable",
          "name": "Default",
          "component": "RequestsTable",
          "source_file": "src/components/RequestsTable.stories.tsx",
          "args": {
            "rows": 25
          }
        }
      ],
      "refs": {
        "component": "components"
      }
    },
    "components": {
      "key": "name",
      "title": "name",
      "items": [
        {
          "name": "ExportButton",
          "stories": 2,
          "file": "src/components/ExportButton.tsx"
        },
        {
          "name": "RequestsTable",
          "stories": 1,
          "file": "src/components/RequestsTable.tsx"
        }
      ]
    }
  }
}
