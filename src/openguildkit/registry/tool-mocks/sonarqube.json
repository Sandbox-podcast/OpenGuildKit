{
  "tool": "sonarqube",
  "instructions": "Mock of a code quality scanner for the fictional Acme Support Portal. Every answer is synthetic.",
  "tools": [
    {
      "name": "search_projects",
      "description": "List the analysed projects with their key and quality gate status.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words that must all appear, whatever the case; an empty text lists everything"
          }
        }
      },
      "serve": {
        "records": "projects",
        "action": "list",
        "fields": [
          "project_key",
          "name",
          "quality_gate"
        ]
      }
    },
    {
      "name": "get_quality_gate",
      "description": "Get the quality gate result of a project, with each condition.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_key": {
            "type": "string",
            "description": "Project key"
          }
        },
        "required": [
          "project_key"
        ]
      },
      "serve": {
        "records": "projects",
        "action": "get"
      }
    },
    {
      "name": "search_issues",
      "description": "Search code issues of a project. Returns rule, severity, file and line.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_key": {
            "type": "string",
            "description": "Project key"
          },
          "type": {
            "type": "string",
            "description": "Issue type",
            "enum": [
              "BUG",
              "CODE_SMELL"
            ]
          }
        },
        "required": [
          "project_key"
        ]
      },
      "serve": {
        "records": "issues",
        "action": "list"
      }
    },
    {
      "name": "get_measures",
      "description": "Get measures of a project: coverage and duplications.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_key": {
            "type": "string",
            "description": "Project key"
          },
          "metric": {
            "type": "string",
            "description": "coverage or duplications"
          }
        },
        "required": [
          "project_key"
        ]
      },
      "serve": {
        "records": "measures",
        "action": "list"
      }
    }
  ],
  "records": {
    "projects": {
      "key": "project_key",
      "title": "name",
      "items": [
        {
          "project_key": "acme_support-portal-docs",
          "name": "support-portal-docs",
          "quality_gate": "OK",
          "conditions": [
            {
              "metric": "new_coverage",
              "status": "OK",
              "actual": "92.0",
              "threshold": "80"
            }
          ]
        },
        {
          "project_key": "acme_support-portal",
          "name": "support-portal",
          "quality_gate": "ERROR",
          "conditions": [
            {
              "metric": "new_coverage",
              "status": "ERROR",
              "actual": "74.0",
              "threshold": "80"
            },
            {
              "metric": "new_duplicated_lines_density",
              "status": "OK",
              "actual": "1.8",
              "threshold": "3"
            },
            {
              "metric": "new_bugs",
              "status": "ERROR",
              "actual": "1",
              "threshold": "0"
            }
          ]
        }
      ]
    },
    "issues": {
      "key": "issue_key",
      "title": "message",
      "items": [
        {
          "type": "BUG",
          "severity": "MAJOR",
          "rule": "python:S2201",
          "file": "portal/export.py",
          "line": 58,
          "message": "Encode the file as UTF-8, not latin-1.",
          "issue_key": "AX-1",
          "project_key": "acme_support-portal"
        },
        {
          "type": "CODE_SMELL",
          "severity": "MINOR",
          "rule": "python:S1192",
          "file": "portal/export.py",
          "line": 21,
          "message": "Define a constant for the repeated string 'status'.",
          "issue_key": "AX-2",
          "project_key": "acme_support-portal"
        },
        {
          "type": "CODE_SMELL",
          "severity": "INFO",
          "rule": "python:S1135",
