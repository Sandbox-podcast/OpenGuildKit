{
  "tool": "sentry",
  "instructions": "Mock of an error tracker for the fictional Acme Support Portal. Every answer is synthetic.",
  "tools": [
    {
      "name": "list_issues",
      "description": "List error issues. Returns id, title, event count and first seen date.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "description": "Project name"
          },
          "status": {
            "type": "string",
            "description": "Issue status",
            "enum": [
              "unresolved",
              "resolved"
            ]
          }
        }
      },
      "serve": {
        "records": "issues",
        "action": "list",
        "fields": [
          "issue_id",
          "title",
          "events",
          "first_seen",
          "status",
          "project"
        ]
      }
    },
    {
      "name": "get_issue",
      "description": "Get one error issue with its stack trace.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "description": "Issue id such as SUPPORT-PORTAL-7"
          }
        },
        "required": [
          "issue_id"
        ]
      },
      "serve": {
        "records": "issues",
        "action": "get"
      }
    },
    {
      "name": "list_releases",
      "description": "List releases with their date and number of new issues.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "description": "Project name"
          }
        }
      },
      "serve": {
        "records": "releases",
        "action": "list"
      }
    }
  ],
  "records": {
    "issues": {
      "key": "issue_id",
      "title": "title",
      "items": [
        {
          "issue_id": "SUPPORT-PORTAL-7",
          "title": "UnicodeEncodeError in export_requests_csv",
          "level": "error",
          "events": 14,
          "users": 5,
          "first_seen": "2026-11-18",
          "last_seen": "2026-11-20",
          "status": "unresolved",
          "project": "support-portal",
          "release": "2026.11.2",
          "message": "'latin-1' codec can't encode character in position 12",
          "stack_trace": [
            {
              "file": "portal/export.py",
              "line": 58,
              "function": "export_requests_csv",
              "code": "handle.write(row.encode('latin-1'))"
            },
            {
              "file": "portal/views.py",
              "line": 112,
              "function": "download_requests",
              "code": "return export_requests_csv(customer)"
            }
          ]
        },
        {
          "issue_id": "SUPPORT-PORTAL-5",
          "title": "TimeoutError in load_request_attachments",
          "level": "error",
          "events": 31,
          "status": "resolved",
          "first_seen": "2026-10-22",
          "last_seen": "2026-11-03",
          "project": "support-portal"
        }
      ],
      "refs": {
        "release": "releases"
      }
    },
    "releases": {
      "key": "version",
      "items": [
        {
          "version": "2026.11.2",
