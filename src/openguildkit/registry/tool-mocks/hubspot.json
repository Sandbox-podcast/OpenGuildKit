{
  "tool": "hubspot",
  "instructions": "Mock of a sales CRM for the fictional Acme Support Portal. Companies and amounts are synthetic.",
  "tools": [
    {
      "name": "search_deals",
      "description": "Search deals by text in their name or notes. Amounts are in EUR.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words that must all appear, whatever the case; an empty text lists everything"
          }
        },
        "required": [
          "query"
        ]
      },
      "serve": {
        "records": "deals",
        "action": "list"
      }
    },
    {
      "name": "get_company",
      "description": "Get one company by id.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "company_id": {
            "type": "string",
            "description": "Company id such as company-101"
          }
        },
        "required": [
          "company_id"
        ]
      },
      "serve": {
        "records": "companies",
        "action": "get"
      }
    },
    {
      "name": "create_note",
      "description": "Add a note to a deal. Returns the note.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deal_id": {
            "type": "string",
            "description": "Deal id"
          },
          "body": {
            "type": "string",
            "description": "Note text"
          }
        },
        "required": [
          "deal_id",
          "body"
        ]
      },
      "responses": [
        {
          "result": {
            "note_id": "note-50",
            "deal_id": "$arg:deal_id",
            "body": "$arg:body",
            "author": "Remy Mock",
            "created": "2026-11-21"
          }
        }
      ],
      "check": {
        "deal_id": "deals"
      }
    }
  ],
  "records": {
    "deals": {
      "key": "deal_id",
      "title": "name",
      "items": [
        {
          "deal_id": "deal-1",
