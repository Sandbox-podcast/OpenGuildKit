{
  "tool": "stripe",
  "instructions": "Mock of a payment platform in test mode. Amounts are in cents, in EUR. Every answer is synthetic.",
  "tools": [
    {
      "name": "list_invoices",
      "description": "List invoices. Amounts are in cents.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Invoice status",
            "enum": [
              "paid",
              "open"
            ]
          }
        }
      },
      "responses": [
        {
          "when": {
            "status": "paid"
          },
          "result": {
            "invoices": [
              {
                "invoice_id": "in_test_001",
                "customer": "cus_test_001",
                "amount_cents": 180000,
                "currency": "eur",
                "status": "paid",
                "date": "2026-10-31"
              }
            ]
          }
        },
        {
          "when": {
            "status": "open"
          },
          "result": {
            "invoices": [
              {
                "invoice_id": "in_test_002",
                "customer": "cus_test_002",
                "amount_cents": 95000,
                "currency": "eur",
                "status": "open",
                "date": "2026-11-15"
              },
              {
                "invoice_id": "in_test_003",
                "customer": "cus_test_003",
                "amount_cents": 24000,
                "currency": "eur",
                "status": "open",
                "date": "2026-11-19"
              }
            ]
          }
        },
        {
          "result": {
            "invoices": [
              {
                "invoice_id": "in_test_001",
                "customer": "cus_test_001",
                "amount_cents": 180000,
                "currency": "eur",
                "status": "paid",
                "date": "2026-10-31"
              },
              {
                "invoice_id": "in_test_002",
                "customer": "cus_test_002",
                "amount_cents": 95000,
                "currency": "eur",
                "status": "open",
                "date": "2026-11-15"
              },
              {
                "invoice_id": "in_test_003",
                "customer": "cus_test_003",
                "amount_cents": 24000,
                "currency": "eur",
                "status": "open",
                "date": "2026-11-19"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "get_subscription",
      "description": "Get one subscription by id.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "subscription_id": {
            "type": "string",
            "description": "Subscription id such as sub_test_001"
          }
        },
        "required": [
          "subscription_id"
        ]
      },
      "responses": [
        {
          "when": {
            "subscription_id": "sub_test_001"
          },
          "result": {
            "subscription_id": "sub_test_001",
            "customer": "cus_test_001",
            "plan": "Portal Business",
            "amount_cents": 15000,
            "currency": "eur",
            "interval": "month",
            "status": "active",
            "renews": "2026-12-01"
          }
        },
        {
          "when": {
            "subscription_id": "sub_test_002"
          },
          "result": {
            "subscription_id": "sub_test_002",
            "customer": "cus_test_002",
            "plan": "Portal Starter",
            "amount_cents": 4900,
            "currency": "eur",
            "interval": "month",
            "status": "past_due",
            "renews": "2026-11-25"
          }
        },
        {
          "error": "Subscription not found. Known ids in this mock: sub_test_001, sub_test_002."
        }
      ]
    },
    {
      "name": "list_customers",
      "description": "List customers. Filter by part of the name.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Part of a customer name"
          }
        }
      },
      "responses": [
        {
          "when": {
            "query": "logistics"
          },
          "result": {
            "customers": [
              {
                "customer_id": "cus_test_001",
                "name": "Example Logistics",
                "email": "billing@example.test"
              }
            ]
          }
        },
        {
          "when": {
            "query": "clinic"
          },
          "result": {
            "customers": [
              {
                "customer_id": "cus_test_002",
                "name": "Sample Clinic Group",
                "email": "accounts@example.test"
              }
            ]
          }
        },
        {
          "result": {
            "customers": [
              {
                "customer_id": "cus_test_001",
                "name": "Example Logistics",
                "email": "billing@example.test"
              },
              {
                "customer_id": "cus_test_002",
                "name": "Sample Clinic Group",
                "email": "accounts@example.test"
              },
              {
                "customer_id": "cus_test_003",
                "name": "Placeholder Retail",
                "email": "finance@example.test"
              }
            ]
          }
        }
      ],
      "search": {
        "argument": "query",
        "collection": "customers",
        "fields": [
          "name",
          "customer_id",
          "email"
        ]
      }
    },
    {
      "name": "refund_invoice",
      "description": "Rehearse a full refund of a paid sample invoice. No payment is made.",
      "read_only": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string",
            "description": "Paid invoice ID from list_invoices"
          }
        },
        "required": [
          "invoice_id"
        ]
      },
      "responses": [
        {
          "when": {
            "invoice_id": "in_test_001"
          },
          "result": {
            "refund_id": "re_test_001",
            "invoice_id": "in_test_001",
            "status": "succeeded",
            "amount_cents": 180000,
            "currency": "eur",
            "simulated": true
          }
        },
        {
          "when": {
            "invoice_id": "in_test_002"
          },
          "error": "in_test_002 is unpaid and cannot be refunded."
        },
        {
          "when": {
            "invoice_id": "in_test_003"
          },
          "error": "in_test_003 is unpaid and cannot be refunded."
        },
        {
          "error": "Invoice not found. Use list_invoices to get a sample invoice ID."
        }
      ]
    }
  ]
}
