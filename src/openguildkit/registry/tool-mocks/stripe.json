          "customer": "cus_test_002",
          "amount_cents": 95000,
          "currency": "eur",
          "status": "open",
          "date": "2026-11-15"
        },
        {
          "invoice_id": "in_test_003",
          "customer": "cus_test_003",
          "amount_cents": 24000,
          "currency": "eur",
          "status": "open",
          "date": "2026-11-19"
        }
      ],
      "refs": {
        "customer": "customers"
      }
    },
    "subscriptions": {
      "key": "subscription_id",
      "title": "plan",
      "items": [
        {
          "subscription_id": "sub_test_001",
          "customer": "cus_test_001",
          "plan": "Portal Business",
          "amount_cents": 15000,
          "currency": "eur",
          "interval": "month",
          "status": "active",
          "renews": "2026-12-01"
        },
        {
          "subscription_id": "sub_test_002",
          "customer": "cus_test_002",
          "plan": "Portal Starter",
          "amount_cents": 4900,
          "currency": "eur",
          "interval": "month",
          "status": "past_due",
          "renews": "2026-11-25"
        },
        {
          "subscription_id": "sub_test_003",
          "customer": "cus_test_003",
          "plan": "Portal Business",
          "amount_cents": 15000,
          "currency": "eur",
