          "renews": null
        }
      ],
      "refs": {
        "customer": "customers"
      }
    },
    "refunds": {
      "key": "refund_id",
      "items": [
        {
          "refund_id": "re_test_001",
          "invoice_id": "in_test_001",
          "customer": "cus_test_001",
          "amount_cents": 15000,
          "currency": "eur",
          "reason": "requested_by_customer",
