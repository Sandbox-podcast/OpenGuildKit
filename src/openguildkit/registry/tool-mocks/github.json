{
  "tool": "github",
  "instructions": "Mock of a code hosting service with one fictional repository, acme/support-portal. Every answer is synthetic.",
  "tools": [
    {
      "name": "list_pull_requests",
      "description": "List pull requests of acme/support-portal. Returns number, title, state, author and branch.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "description": "Filter by state",
            "enum": [
              "open",
              "merged",
              "all"
            ]
          }
        }
      },
      "serve": {
        "records": "pull_requests",
        "action": "list",
        "fields": [
          "number",
          "title",
          "state",
          "author",
          "branch"
        ],
        "wrap": {
          "repository": "acme/support-portal"
        }
      }
    },
    {
      "name": "get_pull_request",
      "description": "Get one pull request by number, with test results and reviewers.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "description": "Pull request number"
          }
        },
        "required": [
          "number"
        ]
      },
      "serve": {
        "records": "pull_requests",
        "action": "get"
      }
    },
    {
      "name": "list_check_runs",
      "description": "List the check runs of a branch or commit reference.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Branch name or commit"
          }
        },
        "required": [
          "ref"
        ]
      },
      "serve": {
        "records": "check_runs",
        "action": "list",
        "wrap": {
          "repository": "acme/support-portal"
        }
      }
    },
    {
      "name": "list_security_alerts",
      "description": "List dependency security alerts of the repository.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "description": "Optional severity filter",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      },
      "serve": {
        "records": "alerts",
        "action": "list",
        "wrap": {
          "repository": "acme/support-portal"
        }
      }
    }
  ],
