{
  "tool": "jira",
  "instructions": "Mock of an issue tracker for the fictional Acme Support Portal. Every answer is synthetic.",
  "tools": [
    {
      "name": "search_issues",
      "description": "Search issues by text. Returns key, summary, status and assignee.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words that must all appear, whatever the case; an empty text lists everything"
          },
          "status": {
            "type": "string",
            "description": "Optional status filter",
            "enum": [
              "To do",
              "In progress",
              "Blocked",
              "Done"
            ]
          }
        },
        "required": [
          "query"
        ]
      },
      "serve": {
        "records": "issues",
        "action": "list",
        "fields": [
          "key",
          "summary",
          "status",
          "assignee"
        ]
      }
    },
    {
      "name": "get_issue",
      "description": "Get one issue by key, with its description and sprint.",
      "read_only": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Issue key such as SUP-142"
          }
        },
        "required": [
          "key"
        ]
      },
      "serve": {
        "records": "issues",
        "action": "get"
      }
    },
    {
      "name": "create_issue",
      "description": "Create an issue. Returns the new key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "Short title"
          },
          "type": {
            "type": "string",
            "description": "Issue type",
            "enum": [
              "Bug",
              "Story",
              "Task"
            ]
          }
        },
        "required": [
          "summary"
        ]
      },
      "responses": [
        {
          "result": {
            "key": "SUP-200",
            "summary": "$arg:summary",
            "type": "$arg:type",
            "status": "To do",
            "created": "2026-11-21"
          }
        }
      ]
    },
    {
      "name": "add_comment",
      "description": "Add a comment to an issue. Returns the comment id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Issue key"
          },
          "body": {
            "type": "string",
            "description": "Comment text"
          }
        },
        "required": [
          "key",
          "body"
        ]
      },
      "responses": [
        {
          "result": {
            "key": "$arg:key",
            "comment_id": "10042",
            "author": "Ada Example",
            "body": "$arg:body",
            "created": "2026-11-21"
          }
        }
      ],
      "check": {
        "key": "issues"
      }
    }
  ],
  "records": {
    "issues": {
      "key": "key",
      "title": "summary",
      "items": [
        {
          "key": "SUP-142",
          "summary": "Export my requests as CSV",
          "type": "Story",
          "status": "In progress",
          "assignee": "Lin Sample",
          "reporter": "Ada Example",
          "sprint": "Sprint 14",
          "created": "2026-10-19",
          "description": "Customers want to download their own support requests as a CSV file from the requests list."
        },
        {
          "key": "SUP-143",
          "summary": "CSV cells starting with = must be neutralised",
          "type": "Task",
          "status": "To do",
          "assignee": "Sam Placeholder",
          "reporter": "Ada Example",
          "sprint": "Sprint 14",
          "created": "2026-11-17",
          "description": "Cells that start with =, +, - or @ must be prefixed so a spreadsheet never runs them as formulas."
        },
        {
          "key": "SUP-120",
          "summary": "Share link for a request",
          "type": "Story",
          "status": "Blocked",
          "assignee": "Noor Fixture",
          "reporter": "Kai Demo",
          "sprint": "Sprint 14",
          "created": "2026-10-06",
          "description": "Let a customer share a read-only link to one request. Blocked until the security review is done.",
          "blocked_by": "Security review of public share links"
        }
      ]
    }
  }
}
